# jina-mcp environment template
#
# Copy this file to `.env` in this directory and fill in the required key,
# OR pass the same values via the MCP `env` block in your `~/.claude.json`.
#
# Required:
#   JINA_API_KEY — Jina AI API key
#
# Get a key at: https://jina.ai
# Free 10M-token trial at signup; PAYG pricing after.

JINA_API_KEY=your-jina-api-key-placeholder

# ── Optional ────────────────────────────────────────────────────────────────

# Which search lane to use.
#   standard (default) — s.jina.ai. Works on trial credits. Use this.
#   vip                — svip.jina.ai. Requires a PAID regular_balance; refuses
#                        trial credits outright. Only set this if you have paid
#                        balance AND need image search.
# JINA_SEARCH_ENDPOINT=standard

# Ghost Content API key, only for `search_jina_blog`. Without it that one tool
# returns an explanatory message; nothing else is affected.
# JINA_GHOST_KEY=

# Per-request timeout in seconds (default 60).
# JINA_TIMEOUT=60

# Max concurrent requests for the parallel_* tools (default 5).
# JINA_MAX_PARALLEL=5

# Model overrides. Defaults track Jina's current generation.
# JINA_EMBED_MODEL=jina-embeddings-v5-text-small
# JINA_RERANK_MODEL=jina-reranker-v3
