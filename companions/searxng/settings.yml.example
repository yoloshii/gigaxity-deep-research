# SearXNG settings for Gigaxity Deep Research
#
# Tuned for use as a JSON API backend feeding the parent project's research
# connector. Engine selection, categories, weights and timeouts were
# re-validated against upstream SearXNG on 2026-09-30 (release 2026.9.30).
#
# Setup:
#   1. Copy this file to settings.yml
#   2. Replace `secret_key` below with output of: openssl rand -hex 32
#   3. docker compose up -d
#
# Most-common gotcha: many public/default SearXNG installs disable the JSON
# format. The parent project requires it. The `formats: [html, json]` block
# under `search:` is what unlocks `?format=json` queries.
#
# Second-most-common gotcha, and the reason this file uses `keep_only` below:
# with a bare `use_default_settings: true`, an `engines:` block does NOT define
# the engine set. Upstream merges it into the ~250 stock engines *by name*, so
# every engine you do not mention keeps its default state. A curated-looking
# list then runs alongside ~79 unaudited default-enabled engines. See
# https://docs.searxng.org/admin/settings/settings.html#use-default-settings
#
# Categories are the routing contract with the parent project. It sends
# `categories=` and, by default, never `engines=` (an explicit engines list
# overrides the `disabled:` flags below, and is never sent on a vertical lane):
#   - every fused search queries `general`;
#   - a vertical lane adds ONE of `science` / `it` / `videos` when the focus
#     mode or a keyword heuristic calls for it;
#   - `docs` and `packages` are defined only here, and are reached only
#     through an explicit `vertical_search` request.
# SearXNG answers a category it does not define from its default categories,
# with no error. The parent project therefore reads this instance's `/config`
# (engines, their categories, enabled flags) and skips any category without an
# enabled engine.
#
# Image version matters. From 2026.9.x the image makes outgoing requests
# through curl_cffi with browser TLS impersonation (earlier images used httpx).
# On a residential test connection the httpx image (2026.8.1) drew a DuckDuckGo
# CAPTCHA and a Brave "too many requests" on the first query, while the
# curl_cffi image (2026.9.30) returned results from both - same IP, same query.
# Some blocks that look like IP reputation are TLS fingerprinting.
#
# Adjust per your jurisdiction — engines blocked from one network often work
# fine from another. Verify yours rather than trusting this file; see
# "Health check" at the bottom.

# `keep_only` makes this an allow-list: engines absent from it are removed
# outright. To add an engine, list it BOTH here and (if you want a non-default
# weight, timeout, category or enabled state) in the `engines:` block further
# down. Unknown names are dropped SILENTLY — re-validate this list against the
# image's engine registry on every image update.
use_default_settings:
  engines:
    keep_only:
      # general web
      - duckduckgo
      - brave
      - wikipedia
      - wikidata
      # science / academic
      - arxiv
      - google scholar
      - semantic scholar
      - pubmed
      - openalex
      - crossref
      # technical (Q&A, repos, discussion)
      - stackoverflow
      - askubuntu
      - superuser
      - github
      - hackernews
      # docs (opt-in vertical)
      - mdn
      - microsoft learn
      - arch linux wiki
      # packages (opt-in vertical)
      - pypi
      - npm
      - crates.io
      - pkg.go.dev
      - docker hub
      - huggingface
      # video
      - youtube

general:
  debug: false
  instance_name: "gigaxity-deep-research-searxng"
  privacypolicy_url: false
  donation_url: false
  contact_url: false
  enable_metrics: true

server:
  # IMPORTANT: replace before exposing the instance.
  # Generate with: openssl rand -hex 32
  secret_key: "placeholder-change-me-to-a-long-random-string-before-exposure"
  base_url: "http://localhost:8888"
  # `limiter` throttles requests INBOUND to your instance. Its upstream purpose
  # is stopping other people's bots from riding your instance and burning your
  # server IP's reputation with the engines. For a private JSON API backend the
  # only client is your own research connector, so turning it on would
  # rate-limit the traffic this instance exists to serve. Leave it false and
  # pace/cache on the CALLER side instead. Set it true the moment the instance
  # becomes publicly reachable.
  limiter: false
  image_proxy: false
  http_protocol_version: "1.0"
  method: "POST"

outgoing:
  # `pool_maxsize` and `keepalive_expiry` were httpx settings and have no
  # effect since the curl_cffi switch; `pool_connections` still applies.
  request_timeout: 3.5
  max_request_timeout: 10.0
  pool_connections: 50
  enable_http2: true

ui:
  static_use_hash: true
  query_in_title: false
  default_theme: simple

search:
  safe_search: 0
  autocomplete: "duckduckgo"
  autocomplete_min: 4
  favicon_resolver: ""
  default_lang: "auto"
  # `ban_time_on_fail`, `max_ban_time_on_fail` and `suspended_times` are
  # deliberately NOT set, so upstream's defaults apply (2026.9.30: CAPTCHA
  # 3600 s, too-many-requests 180 s, access-denied 180 s, Cloudflare CAPTCHA
  # 15 days, reCAPTCHA 7 days). Shorter suspensions re-probe a blocked engine
  # every few minutes, which keeps the instance's IP flagged.
  formats:
    - html
    - json                     # required by gigaxity-deep-research

engines:
  # ============================================
  # GENERAL WEB — categories=general
  # ============================================

  - name: brave
    # Independent index, and the strongest general engine when reachable.
    # Scraped, so it rate-limits under sustained automated load. If you drive
    # this backend hard, also configure Brave's official API in the parent
    # project (RESEARCH_BRAVE_API_KEY) rather than raising the weight.
    disabled: false
    weight: 5
    timeout: 4.0

  - name: duckduckgo
    # Best-measured general engine for research-shaped queries. Also CAPTCHAs
    # fastest under bursts. Pace the caller; do not compensate by re-enabling
    # bing.
    disabled: false
    weight: 4
    timeout: 4.0

  - name: wikipedia
    disabled: false
    weight: 5
    timeout: 3.0

  - name: wikidata
    disabled: false
    weight: 3
    timeout: 4.0

  # ============================================
  # SCIENCE / ACADEMIC — categories=science
  # ============================================

  - name: arxiv
    disabled: false
    weight: 4
    timeout: 6.0

  - name: semantic scholar
    disabled: false
    weight: 4
    timeout: 6.0

  - name: google scholar
    engine: google_scholar
    disabled: false
    weight: 4
    timeout: 8.0

  - name: openalex
    # OpenAlex API, no key. Off upstream by default.
    disabled: false
    weight: 3
    timeout: 6.0

  - name: pubmed
    disabled: false
    weight: 3
    timeout: 6.0

  - name: crossref
    # Crossref API, no key. Metadata-heavy, so weighted low. Upstream's
    # default timeout is 30 s; capped here so one slow API cannot stall the lane.
    disabled: false
    weight: 2
    timeout: 6.0

  # ============================================
  # TECHNICAL — categories=it
  # ============================================

  - name: stackoverflow
    disabled: false
    weight: 4
    timeout: 4.0

  - name: github
    disabled: false
    weight: 3
    timeout: 5.0

  - name: hackernews
    # Algolia HN search — practitioner discussion.
    disabled: false
    weight: 2
    timeout: 5.0

  - name: askubuntu
    disabled: false
    weight: 2
    timeout: 4.0

  - name: superuser
    disabled: false
    weight: 2
    timeout: 4.0

  # ============================================
  # DOCS — opt-in, categories=docs
  # Kept out of `it`: MDN and Microsoft Learn keyword-match across languages
  # (a Python httpx question drew JavaScript `async function` and Azure
  # pages), which displaces real answers under RRF.
  # ============================================

  - name: mdn
    categories: [docs]
    disabled: false
    weight: 3
    timeout: 4.0

  - name: microsoft learn
    categories: [docs]
    disabled: false
    weight: 3
    timeout: 5.0

  - name: arch linux wiki
    categories: [docs]
    disabled: false
    weight: 3
    timeout: 5.0

  # ============================================
  # PACKAGES — opt-in, categories=packages
  # Categories overridden to keep registry hits out of the `it` lane: a
  # package listing that merely matches a word displaces real answers.
  # ============================================

  - name: pypi
    categories: [packages]
    disabled: false
    weight: 2
    timeout: 4.0

  - name: npm
    categories: [packages]
    disabled: false
    weight: 2
    timeout: 5.0

  - name: crates.io
    categories: [packages]
    disabled: false
    weight: 2
    timeout: 6.0

  - name: pkg.go.dev
    categories: [packages]
    disabled: false
    weight: 2
    timeout: 5.0

  - name: docker hub
    categories: [packages]
    disabled: false
    weight: 2
    timeout: 5.0

  - name: huggingface
    categories: [packages]
    disabled: false
    weight: 2
    timeout: 5.0

  # ============================================
  # VIDEO — categories=videos
  # ============================================

  - name: youtube
    disabled: false
    weight: 3
    timeout: 4.0

# ============================================
# Re-enable candidates — dropped from keep_only on 2026-09-30
# ============================================
#
# Each failed on the test network; yours may differ. To try one, add it to
# `keep_only` AND give it an `engines:` entry with `disabled: false`, then run
# the health check below.
#
#   startpage    — ships `inactive: true` upstream: it now answers only after
#                  a proof-of-work challenge (searxng PR #6669), which refused
#                  with "difficulty too high" on the test network.
#   mojeek       — ships `inactive: true` upstream; served "unusual traffic"
#                  pages at HTTP 200, which SearXNG parses as a clean zero.
#   bing         — served bot-block pages ("Microsoft Official Home Page",
#                  "Sign in to your account") at HTTP 200 with no error signal.
#                  RRF fuses on rank, so junk at any weight displaces good results.
#   qwant        — Cloudflare-blocked from many residential IPs. Supports
#                  `use_official_api` with an `api_key`, which does not CAPTCHA.
#   wolframalpha — the no-API engine timed out; disabled upstream.
#   openairepublications — timed out at 6 s; OpenAlex covers the same corpus.
#   google news  — fixed upstream in May 2026 (searxng PR #5984) but still
#                  depends on server-IP reputation; confirm non-zero results.
#
# Removed upstream (naming them does nothing — keep_only drops unknown names):
# karmasearch (PR #6213), reddit and aol are absent from the 2026.9.30 engine
# registry. `google` (web) is still registered but ships `disabled: true`, and
# answers only through a signed-in browser session (discussion #5651).

doi_resolvers:
  oadoi.org: "https://oadoi.org/"
  doi.org: "https://doi.org/"

default_doi_resolver: "oadoi.org"

# ============================================
# Health check — silent degradation is the real failure mode
# ============================================
#
# SearXNG returns HTTP 200 with partial or junk results when upstream engines
# CAPTCHA or block; nothing in the status code tells you. The response carries
# an `unresponsive_engines` field naming every engine that failed:
#
#   curl -s 'http://localhost:8888/search?q=test&format=json' \
#     | python3 -c 'import sys,json;d=json.load(sys.stdin);print(d["unresponsive_engines"]);print(d["number_of_results"])'
#
# Typical entries: ["brave","Suspended: too many requests"],
# ["duckduckgo","CAPTCHA"]. The parent project's `vertical_search` tool prints
# them in its footer, and its REST endpoint returns them as
# `unresponsive_engines`.
#
# Check every category, not just `general`:
#
#   for c in general science it videos docs packages; do
#     curl -s "http://localhost:8888/search?q=python+asyncio&format=json&categories=$c" \
#       | python3 -c "import sys,json,collections;d=json.load(sys.stdin);print('$c',len(d['results']),dict(collections.Counter(r.get('category') for r in d['results'])),d['unresponsive_engines'])"
#   done
#
# A category that reports only `general` results is not defined on the
# instance. Alert when the healthy general-category pool drops below about
# three engines. Below that, one misbehaving engine dominates the RRF fusion
# and results collapse topically while still returning 200.
#
# ============================================
# Durable lanes — for sustained automated load
# ============================================
#
# Scraped engines lose the anti-bot arms race by design; upstream has removed
# engines outright when a provider's blocking became permanent. If this backend
# serves real query volume, put at least one lane on an official API — no
# XPath to break, no CAPTCHA risk from server IPs:
#
#   - Brave Search API or Parallel Search API, configured in the parent project
#   - qwant, mwmbl, core, tagesschau (support use_official_api + api_key)
#
# Most science engines here are already API-backed (arXiv, OpenAlex, PubMed,
# Crossref, Semantic Scholar), so the `science` lane usually keeps answering
# when the scraped general engines are blocked.
#
# The alternatives are rotating egress IPs (residential proxies or multiple
# VPS) or accepting lower throughput.
