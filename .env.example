# Gigaxity Deep Research — example environment
#
# Copy this file to .env and fill in the values you need.
# Anything left blank falls back to the default in src/config.py.
#
# All variables are prefixed with RESEARCH_ so they don't collide with
# unrelated tooling in the same shell environment.

# -- LLM (default: OpenRouter-hosted Qwen3-30B-A3B-Thinking) ------------------
# Get an API key at https://openrouter.ai/keys
RESEARCH_LLM_API_BASE=https://openrouter.ai/api/v1
RESEARCH_LLM_API_KEY=
RESEARCH_LLM_MODEL=qwen/qwen3-30b-a3b-thinking-2507
RESEARCH_LLM_TEMPERATURE=0.85
RESEARCH_LLM_TOP_P=0.95
RESEARCH_LLM_MAX_TOKENS=16384
RESEARCH_LLM_TIMEOUT=120
# Retries the OpenAI SDK performs per request => (value + 1) attempts. Defaults to
# the SDK's own 2, so leaving it unset changes nothing. Read-timeouts are retried
# like 429s, so this MULTIPLIES RESEARCH_LLM_TIMEOUT: a stalled connection costs
# about (retries + 1) x timeout of silent retrying. Lowering it shortens that stall
# and gives up a recovery attempt.
RESEARCH_LLM_MAX_RETRIES=2
# Absolute wall-clock ceiling (seconds) for ONE model call including the SDK's
# retry chain. 0 disables it, which is the default. Server-wide resource policy:
# it applies to MCP, REST and library calls made through this project's client
# wrapper (an injected client owns its own timeouts). Left off because the right
# ceiling depends on the endpoint — a hosted model's generation time is bounded,
# a slow local server's is not, and a ceiling that kills healthy local generation
# is worse than none. 480 is a reasonable starting profile for a hosted endpoint.
RESEARCH_LLM_WALL_CLOCK_CAP=0
# Seconds between "still running" progress notifications while a model call is in
# flight. A call shorter than one interval emits none. Lower it if your MCP
# client's idle window is tight.
RESEARCH_PROGRESS_HEARTBEAT_INTERVAL=30
# Seconds one progress notification may take before reporting is disabled for the
# rest of the request. Guards against a transport that hangs rather than errors.
RESEARCH_PROGRESS_SEND_TIMEOUT=10
# Max concurrent RCS contextual-summary calls (synthesis pipeline). Tune up (16-32)
# for hosted endpoints that accept more parallelism; <1 is floored to 1 (serial).
RESEARCH_RCS_CONCURRENCY=4
# Pre-synthesis relevance-gate fail-open floor. On a REJECT (or PARTIAL-with-zero-good)
# decision, if at least one source scores >= this, synthesis runs over the set-aside
# sources with a low-relevance caveat (non-cached) instead of refusing; below it (no
# source clears the floor) the gate still refuses. 0.3 = the REJECT threshold.
RESEARCH_FAIL_OPEN_MIN_SOURCE_SCORE=0.3

# -- SearXNG (primary search source) -----------------------------------------
# Run your own SearXNG instance (https://docs.searxng.org/) or point at any
# self-hosted or third-party SearXNG endpoint that exposes the JSON API.
RESEARCH_SEARXNG_HOST=http://localhost:8888
RESEARCH_SEARXNG_ENGINES=brave,duckduckgo,startpage,mojeek,wikipedia
RESEARCH_SEARXNG_CATEGORIES=general
RESEARCH_SEARXNG_LANGUAGE=en
RESEARCH_SEARXNG_SAFESEARCH=0

# -- Tavily (optional fallback search) ---------------------------------------
# Get an API key at https://tavily.com
RESEARCH_TAVILY_API_KEY=
RESEARCH_TAVILY_SEARCH_DEPTH=advanced

# -- LinkUp (optional fallback search) ---------------------------------------
# Get an API key at https://linkup.so
RESEARCH_LINKUP_API_KEY=
RESEARCH_LINKUP_DEPTH=standard

# -- Brave Search (optional; the CAPTCHA-immune general-web lane) -------------
# Official Brave index via keyed API, so it cannot be served a bot-block page
# the way SearXNG's scraped engines can. Free tier is ~1,000 queries/month
# (recurring). Get a key at https://brave.com/search/api/
RESEARCH_BRAVE_API_KEY=
RESEARCH_BRAVE_COUNTRY=
RESEARCH_BRAVE_SAFESEARCH=off

# -- Search aggregation ------------------------------------------------------
RESEARCH_DEFAULT_TOP_K=10
RESEARCH_RRF_K=60

# -- Server (REST API mode only — ignored when running as MCP stdio) ---------
RESEARCH_HOST=127.0.0.1
RESEARCH_PORT=8000
